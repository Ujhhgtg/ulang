// Test from requirements: scoped code blocks
fn main() -> i32 {
    let mut x = 1;

    let value = {
        let x = 1; // name does not clash with outer scope
        let y = 2;
        x + y
    };
    // value is 3, x is still 1 (mut)

    // Verify outer x unchanged
    x + value  // 1 + 3 = 4
}
