use std::cmp::Eq;
use std::cmp::Ord;
use std::clone::Clone;
use std::default::Default;
use std::ops::Add;

struct Point {
    x: i32,
    y: i32,
}

impl Add for Point {
    fn add(&self, other: &Self) -> Self {
        Point { x: self.x + other.x, y: self.y + other.y };
    }
}

fn main() {
    let p = Point { x: 1, y: 2 };
    let q = Point { x: 3, y: 4 };
    let r = p.add(&q);
}
