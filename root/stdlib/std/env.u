use std::io::Result;
use std::io::Error;
use std::io::to_c_str;
use std::path::PathBuf;
use std::libc::chdir;
use std::libc::free;
use std::libc::getcwd;
use std::intrinsics::transmute;
use std::intrinsics::slice_from_raw_parts;

pub fn set_current_dir(path: &str) -> Result<()> {
    let path_c = to_c_str(path);
    let res = chdir(path_c);
    free(path_c);
    if res < 0 {
        return Result::Err(Error::last_os_error());
    };
    Result::Ok(())
}

pub fn set_current_dir(path: &PathBuf) -> Result<()> {
    set_current_dir(path.as_str())
}

pub fn current_dir() -> Result<PathBuf> {
    let ptr = getcwd(0 as *mut u8, 0);
    if (ptr as usize) == 0 {
        return Result::Err(Error::last_os_error());
    };
    let mut len = 0;
    while *( (ptr as usize + len) as *const u8 ) != 0u8 {
        len = len + 1;
    };
    let s = transmute::<&[u8], &str>(slice_from_raw_parts(ptr, len));
    let path = PathBuf::from(s);
    free(ptr);
    Result::Ok(path)
}
