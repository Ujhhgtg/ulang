use std::string::String;
use std::vec::Vec;
use std::libc::printf;

pub fn print(x: i32) {
    printf("%d".0, x);
}

pub fn println(x: i32) {
    printf("%d\n".0, x);
}

pub fn print(s: &str) {
    printf("%.*s".0, s.1 as i32, s.0);
}

pub fn println(s: &str) {
    printf("%.*s\n".0, s.1 as i32, s.0);
}

pub fn print(s: String) {
    printf("%.*s".0, s.len() as i32, s.as_ptr());
}

pub fn println(s: String) {
    printf("%.*s\n".0, s.len() as i32, s.as_ptr());
}
