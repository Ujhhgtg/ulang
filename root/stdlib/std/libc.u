extern "C" {
    pub fn malloc(size: usize) -> *mut u8;
    pub fn realloc(ptr: *mut u8, new_size: usize) -> *mut u8;
    pub fn free(ptr: *mut u8);
    pub fn memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
    pub fn printf(fmt: *const i8, ...) -> i32;
    pub fn abort() -> !;
    pub fn _Exit(code: i32) -> !;
    pub fn fork() -> i32;
    pub fn execvp(file: *const u8, argv: *const *mut u8) -> i32;
    pub fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    pub fn posix_spawnp(
        pid: *mut i32,
        file: *const u8,
        file_actions: *mut u8,
        attrp: *mut u8,
        argv: *const *mut u8,
        envp: *const *mut u8,
    ) -> i32;
    pub fn dlsym(handle: *mut u8, symbol: *const u8) -> *mut u8;

    pub fn open(pathname: *const u8, flags: i32, mode: u32) -> i32;
    pub fn close(fd: i32) -> i32;
    pub fn read(fd: i32, buf: *mut u8, count: usize) -> isize;
    pub fn write(fd: i32, buf: *const u8, count: usize) -> isize;
    pub fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    pub fn unlink(pathname: *const u8) -> i32;
    pub fn rmdir(pathname: *const u8) -> i32;
    pub fn mkdir(pathname: *const u8, mode: u32) -> i32;
    pub fn rename(oldpath: *const u8, newpath: *const u8) -> i32;
    pub fn getcwd(buf: *mut u8, size: usize) -> *mut u8;
    pub fn chdir(path: *const u8) -> i32;
    pub fn opendir(name: *const u8) -> *mut u8;
    pub fn readdir(dirp: *mut u8) -> *mut u8;
    pub fn closedir(dirp: *mut u8) -> i32;
    pub fn stat(pathname: *const u8, statbuf: *mut u8) -> i32;
    pub fn lstat(pathname: *const u8, statbuf: *mut u8) -> i32;
    pub fn __errno_location() -> *mut i32;
    pub fn strerror(errnum: i32) -> *const u8;
}
