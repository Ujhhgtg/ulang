use std::vec::Vec;
use std::intrinsics::transmute;
use std::alloc::malloc;
use std::alloc::realloc;
use std::alloc::free;
use std::alloc::memcpy;

pub struct String {
    pub vec: Vec<u8>,
}

impl String {
    pub fn new() -> String {
        String { vec: Vec::new() }
    }

    pub fn with_capacity(cap: usize) -> String {
        String { vec: Vec::with_capacity(cap) }
    }

    pub fn len(&self) -> usize {
        self.vec.len()
    }

    pub fn capacity(&self) -> usize {
        let v = self.vec;
        v.capacity()
    }
    
    pub fn is_empty(&self) -> bool {
        self.vec.is_empty()
    }

    pub fn clear(&mut self) {
        self.vec.clear()
    }

    pub fn push_str(&mut self, s: &str) {
        let mut v = self.vec;
        let new_len = v.len + s.1;
        if new_len > v.cap {
            let mut new_cap = if v.cap == 0 { 1 } else { v.cap * 2 };
            if new_len > new_cap {
                new_cap = new_len;
            };
            let new_ptr = if v.cap == 0 {
                malloc(new_cap)
            } else {
                realloc(v.ptr, new_cap)
            };
            v.ptr = new_ptr;
            v.cap = new_cap;
        };
        memcpy((v.ptr as usize + v.len) as *mut u8, s.0, s.1);
        v.len = new_len;
        self.vec = v;
    }

    pub fn as_ptr(&self) -> *const u8 {
        self.vec.as_ptr()
    }

    pub fn as_str(&self) -> &str {
        transmute::<&[u8], &str>(self.vec.as_slice())
    }

    pub fn drop(&mut self) {
        self.vec.drop()
    }
}

impl str {
    pub fn to_string(&self) -> String {
        let len = self.1;
        let mut s = String::with_capacity(len);
        let v = s.vec;
        memcpy(v.ptr, self.0, len);
        v.len = len;
        s.vec = v;
        s
    }
}
