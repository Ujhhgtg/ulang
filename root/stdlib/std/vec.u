use std::option::Option;
use std::alloc::malloc;
use std::alloc::realloc;
use std::alloc::free;
use std::alloc::memcpy;
use std::iter::IntoIterator;
use std::iter::IntoIteratorMut;
use std::iter::Iter;
use std::intrinsics::{size_of, slice_from_raw_parts, slice_from_raw_parts_mut};
use std::iter::IterMut;
use std::drop::Drop;

pub struct Vec<T> {
    pub ptr: *mut u8,
    pub len: usize,
    pub cap: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec { ptr: 0 as *mut u8, len: 0, cap: 0 }
    }

    pub fn with_capacity(cap: usize) -> Vec<T> {
        let ptr = if cap == 0 { 0 as *mut u8 } else { malloc(cap) };
        Vec { ptr: ptr, len: 0, cap: cap }
    }

    pub fn len(&self) -> usize { self.len }

    pub fn capacity(&self) -> usize { self.cap }
    
    pub fn is_empty(&self) -> bool { self.len == 0 }

    pub fn push(&mut self, elem: T) {
        let elem_size = size_of::<T>();
        if self.len == self.cap {
            let new_cap = if self.cap == 0 { 1 } else { self.cap * 2 };
            let new_size = new_cap * elem_size;
            let new_ptr = if self.cap == 0 {
                malloc(new_size)
            } else {
                realloc(self.ptr, new_size)
            };
            self.ptr = new_ptr;
            self.cap = new_cap;
        };
        let dest = (self.ptr as usize + self.len * elem_size) as *mut T;
        *dest = elem;
        self.len = self.len + 1;
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 {
            Option::None
        } else {
            self.len = self.len - 1;
            let elem_size = size_of::<T>();
            let src = (self.ptr as usize + self.len * elem_size) as *const T;
            Option::Some(*src)
        }
    }

    pub fn clear(&mut self) { self.len = 0; }

    pub fn as_ptr(&self) -> *const u8 { self.ptr }

    pub fn as_slice(&self) -> &[T] {
        slice_from_raw_parts(self.ptr as *const T, self.len)
    }

    pub fn as_mut_slice(&mut self) -> &mut [T] {
        slice_from_raw_parts_mut(self.ptr as *mut T, self.len)
    }
}

impl<T> Drop for Vec<T> {
    fn drop(&mut self) {
        if self.cap > 0 {
            free(self.ptr);
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.cap = 0;
        };
    }
}

impl<T> IntoIterator<T> for Vec<T> {
    fn iter(&self) -> Iter<T> {
        let elem_size = size_of::<T>();
        let start = self.ptr;
        let end = (start as usize + self.len * elem_size) as *mut u8;
        Iter { ptr: start, end: end }
    }
}

impl<T> IntoIteratorMut<T> for Vec<T> {
    fn iter_mut(&mut self) -> IterMut<T> {
        let elem_size = size_of::<T>();
        let start = self.ptr;
        let end = (start as usize + self.len * elem_size) as *mut u8;
        IterMut { ptr: start, end: end }
    }
}
