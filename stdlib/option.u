use std::panic::panic;

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn is_some(&self) -> bool {
        match *self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }
    fn is_none(&self) -> bool {
        match *self {
            Option::Some(_) => false,
            Option::None => true,
        }
    }
    fn unwrap(&self) -> T {
        match *self {
            Option::Some(val) => val,
            Option::None => {
                panic("called `Option::unwrap()` on a `None` value");
            }
        }
    }
    fn unwrap_or(&self, default: T) -> T {
        match *self {
            Option::Some(val) => val,
            Option::None => default,
        }
    }
}
