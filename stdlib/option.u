use std::panic::panic;

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn is_some(&self) -> bool { self.__tag == 0 as i8 }
    fn is_none(&self) -> bool { self.__tag != 0 as i8 }
    fn unwrap(&self) -> T {
        if self.__tag != 0 as i8 { panic("called `Option::unwrap()` on a `None` value"); };
        self.__Some
    }
    fn unwrap_or(&self, default: T) -> T {
        if self.__tag == 0 as i8 { self.__Some } else { default }
    }
}
