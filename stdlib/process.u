use std::vec::Vec;
use std::option::Option;

extern "C" {
    fn _Exit(code: i32) -> !;
    fn fork() -> i32;
    fn execvp(file: *const u8, argv: *const *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

fn exit() -> ! {
    _Exit(0);
}

fn exit(code: i32) -> ! {
    _Exit(code);
}

struct Command {
    program: *mut u8,
    args: Vec<*mut u8>,
}

impl Command {
    fn to_c_str(s: &str) -> *mut u8 {
        let len = s.1;
        let ptr = malloc(len + 1);
        memcpy(ptr, s.0, len);
        *((ptr as usize + len) as *mut u8) = 0u8;
        ptr
    }

    fn new(program: &str) -> Command {
        let prog_c = Command::to_c_str(program);
        let mut args_vec: Vec<*mut u8> = Vec {
            ptr: 0 as *mut u8,
            len: 0,
            cap: 0,
        };
        args_vec.push(prog_c);
        Command {
            program: prog_c,
            args: args_vec,
        }
    }

    fn arg(&mut self, arg: &str) -> &mut Command {
        self.args.push(Command::to_c_str(arg));
        self
    }

    fn args(&mut self, args: [&str; 1]) -> &mut Command {
        self.arg(args[0]);
        self
    }

    fn args(&mut self, args: [&str; 2]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self
    }

    fn args(&mut self, args: [&str; 3]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self
    }

    fn args(&mut self, args: [&str; 4]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self.arg(args[3]);
        self
    }

    fn args(&mut self, args: [&str; 5]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self.arg(args[3]);
        self.arg(args[4]);
        self
    }

    fn args(&mut self, args: [&str; 6]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self.arg(args[3]);
        self.arg(args[4]);
        self.arg(args[5]);
        self
    }

    fn args(&mut self, args: [&str; 7]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self.arg(args[3]);
        self.arg(args[4]);
        self.arg(args[5]);
        self.arg(args[6]);
        self
    }

    fn args(&mut self, args: [&str; 8]) -> &mut Command {
        self.arg(args[0]);
        self.arg(args[1]);
        self.arg(args[2]);
        self.arg(args[3]);
        self.arg(args[4]);
        self.arg(args[5]);
        self.arg(args[6]);
        self.arg(args[7]);
        self
    }

    fn spawn(&mut self) {
        let pid = fork();
        if pid == 0 {
            let argc = self.args.len();
            let argv_size = (argc + 1) * __builtin_size_of(0 as *mut u8);
            let argv = malloc(argv_size) as *mut *mut u8;
            let mut i = 0;
            while i < argc {
                let elem_ptr = (self.args.as_ptr() as usize + i * __builtin_size_of(0 as *mut u8)) as *const *mut u8;
                let dest = (argv as usize + i * __builtin_size_of(0 as *mut u8)) as *mut *mut u8;
                *dest = *elem_ptr;
                i = i + 1;
            };
            let dest_null = (argv as usize + argc * __builtin_size_of(0 as *mut u8)) as *mut *mut u8;
            *dest_null = 0 as *mut u8;

            execvp(self.program, argv);
            _Exit(127);
        }
    }

    fn status(&mut self) -> i32 {
        let pid = fork();
        if pid == 0 {
            let argc = self.args.len();
            let argv_size = (argc + 1) * __builtin_size_of(0 as *mut u8);
            let argv = malloc(argv_size) as *mut *mut u8;
            let mut i = 0;
            while i < argc {
                let elem_ptr = (self.args.as_ptr() as usize + i * __builtin_size_of(0 as *mut u8)) as *const *mut u8;
                let dest = (argv as usize + i * __builtin_size_of(0 as *mut u8)) as *mut *mut u8;
                *dest = *elem_ptr;
                i = i + 1;
            };
            let dest_null = (argv as usize + argc * __builtin_size_of(0 as *mut u8)) as *mut *mut u8;
            *dest_null = 0 as *mut u8;

            execvp(self.program, argv);
            _Exit(127);
        };
        if pid < 0 {
            return 0 - 1;
        };
        let mut status_val = 0;
        let wait_res = waitpid(pid, &mut status_val, 0);
        if wait_res < 0 {
            return 0 - 1;
        };
        let mod_128 = status_val - (status_val / 128) * 128;
        if mod_128 == 0 {
            let div = status_val / 256;
            return div - (div / 256) * 256;
        };
        0 - 1
    }

    fn drop(&mut self) {
        while !self.args.is_empty() {
            let opt: Option<*mut u8> = self.args.pop();
            let arg_ptr = opt.unwrap();
            free(arg_ptr);
        }
    }
}
