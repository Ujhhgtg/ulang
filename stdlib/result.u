use std::panic::panic;

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn is_ok(&self) -> bool { self.__tag == 0 as i8 }
    fn is_err(&self) -> bool { self.__tag != 0 as i8 }
    fn unwrap(&self) -> T {
        if self.__tag != 0 as i8 { panic("called `Result::unwrap()` on an `Err` value"); };
        self.__Ok
    }
    fn unwrap_err(&self) -> E {
        if self.__tag == 0 as i8 { panic("called `Result::unwrap_err()` on an `Ok` value"); };
        self.__Err
    }
}
