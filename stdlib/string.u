use std::vec::Vec;

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn realloc(ptr: *mut u8, new_size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

struct String {
    vec: Vec<u8>,
}

impl String {
    fn new() -> String {
        String { vec: Vec::new() }
    }

    fn with_capacity(cap: usize) -> String {
        String { vec: Vec::with_capacity(cap) }
    }

    fn len(&self) -> usize {
        let v = self.vec;
        v.len()
    }

    fn capacity(&self) -> usize {
        let v = self.vec;
        v.capacity()
    }
    
    fn is_empty(&self) -> bool {
        let v = self.vec;
        v.is_empty()
    }

    fn clear(&mut self) {
        let mut v = self.vec;
        v.clear();
        self.vec = v;
    }

    fn push_str(&mut self, s: &str) {
        let mut v = self.vec;
        let new_len = v.len + s.1;
        if new_len > v.cap {
            let mut new_cap = if v.cap == 0 { 1 } else { v.cap * 2 };
            if new_len > new_cap {
                new_cap = new_len;
            };
            let new_ptr = if v.cap == 0 {
                malloc(new_cap)
            } else {
                realloc(v.ptr, new_cap)
            };
            v.ptr = new_ptr;
            v.cap = new_cap;
        };
        memcpy((v.ptr as usize + v.len) as *mut u8, s.0, s.1);
        v.len = new_len;
        self.vec = v;
    }

    fn as_ptr(&self) -> *const u8 {
        let v = self.vec;
        v.as_ptr()
    }

    fn drop(&mut self) {
        let mut v = self.vec;
        v.drop();
        self.vec = v;
    }
}
