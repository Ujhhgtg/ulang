use std::vec::Vec;

struct String {
    vec: Vec<u8>,
}

impl String {
    fn new() -> String {
        String { vec: Vec::new() }
    }

    fn with_capacity(cap: usize) -> String {
        String { vec: Vec::with_capacity(cap) }
    }

    fn len(&self) -> usize { self.vec.len() }
    fn capacity(&self) -> usize { self.vec.capacity() }
    fn is_empty(&self) -> bool { self.vec.is_empty() }

    fn clear(&mut self) {
        self.vec.clear();
    }

    fn push_str(&mut self, s: &str) {
        let mut i = 0;
        while i < s.1 {
            let byte = *((s.0 as usize + i) as *const u8);
            self.vec.push(byte);
            i = i + 1;
        }
    }

    fn as_ptr(&self) -> *const u8 { self.vec.as_ptr() }

    fn drop(&mut self) {
        // Vec::drop handles deallocation
    }
}
